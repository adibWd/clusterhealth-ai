# Copy this file to docker/.env and fill in the channels you want to use.
# Any channel left blank is simply skipped -- you don't need all of them.

# Required by docker compose. Use a long random value; do not use the former
# default "admin" outside an isolated local demo.
GRAFANA_ADMIN_PASSWORD=cluster123

# Keep false unless you intentionally configure kubectl access and an action
# token. The API simulates cordon/drain by default.
ENABLE_REAL_K8S_ACTIONS=false
ACTION_API_TOKEN=

# --- Slack ---
# Create at: https://api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# --- Discord ---
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- Email (SMTP) ---
# Example for Gmail: use an "App Password", not your normal password
# https://support.google.com/accounts/answer/185833
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
