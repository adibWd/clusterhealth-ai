{
  "title": "ClusterHealth AI — Cluster Intelligence",
  "uid": "clusterhealth-ai",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "GPU Temperature (°C) — raw hardware telemetry",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP",
          "legendFormat": "gpu-{{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "celsius" }, "overrides": [] }
    },
    {
      "id": 2,
      "title": "AI-Predicted Failure Risk — same devices, same timeline",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "clusterhealth_ai_failure_risk",
          "legendFormat": "gpu-{{gpu}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "red", "value": 0.75 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "ECC Error Bursts (early failure signature)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_ECC_SBE_VOL_TOTAL",
          "legendFormat": "gpu-{{gpu}} single-bit",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_ECC_DBE_VOL_TOTAL",
          "legendFormat": "gpu-{{gpu}} double-bit",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Devices Currently at High Risk",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(clusterhealth_ai_risk_level_numeric == 2)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Power Draw (W)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "gpu-{{gpu}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "watt" }, "overrides": [] }
    }
  ]
}
